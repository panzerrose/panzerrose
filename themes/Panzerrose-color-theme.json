{
  "name": "Panzerrose",
  "type": "dark",
  "colors": {
    "editor.background": "#151719",
    "editor.foreground": "#E7E0D8",
    "editorCursor.foreground": "#C68F7B",
    "editor.lineHighlightBackground": "#31383E",
    "editor.selectionBackground": "#626D5D",
    "activityBar.background": "#181615",
    "activityBar.foreground": "#E7E0D8",
    "activityBar.inactiveForeground": "#A7A09A",
    "activityBarBadge.background": "#C2A478",
    "activityBarBadge.foreground": "#151719",
    "sideBar.background": "#31383E",
    "sideBar.foreground": "#E7E0D8",
    "sideBarTitle.foreground": "#C2A478",
    "sideBarSectionHeader.background": "#353C42",
    "sideBarSectionHeader.foreground": "#E7E0D8",
    "titleBar.activeBackground": "#181615",
    "titleBar.activeForeground": "#E7E0D8",
    "titleBar.inactiveBackground": "#151719",
    "titleBar.inactiveForeground": "#A7A09A",
    "editorGroupHeader.tabsBackground": "#181615",
    "tab.activeBackground": "#151719",
    "tab.activeForeground": "#E7E0D8",
    "tab.activeBorderTop": "#C68F7B",
    "tab.inactiveBackground": "#31383E",
    "tab.inactiveForeground": "#A7A09A",
    "panel.background": "#31383E",
    "panel.border": "#353C42",
    "panelTitle.activeForeground": "#E7E0D8",
    "panelTitle.activeBorder": "#C68F7B",
    "panelTitle.inactiveForeground": "#A7A09A",
    "statusBar.background": "#181615",
    "statusBar.foreground": "#E7E0D8",
    "statusBar.debuggingBackground": "#C8A35D",
    "input.background": "#151719",
    "input.foreground": "#E7E0D8",
    "input.border": "#353C42",
    "inputOption.activeBorder": "#B97A67",
    "dropdown.background": "#31383E",
    "dropdown.foreground": "#E7E0D8",
    "dropdown.border": "#353C42",
    "button.background": "#C68F7B",
    "button.foreground": "#151719",
    "button.hoverBackground": "#B97A67",
    "focusBorder": "#C68F7B",
    "foreground": "#E7E0D8",
    "descriptionForeground": "#A7A09A",
    "errorForeground": "#C26B6B"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#87936F"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B97A67"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#87936F"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#C2A478"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "variable.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#B97A67"
      }
    },
    {
      "name": "Classes, types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#98A2A8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E7E0D8"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#A7A09A"
      }
    },
    {
      "name": "HTML and XML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#98A2A8"
      }
    },
    {
      "name": "Attributes and properties",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#C2A478"
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C26B6B"
      }
    }
  ]
}
